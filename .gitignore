# secrets -- the OpenRouter API key lives in .env
.env
.env.*

# environment / caches
.venv/
__pycache__/
*.pyc

# input data (large, not redistributed): put the BIM and scan tiles in data/
data/
*.laz
*.las

# never commit an answer key
*answer_key*/
ground_truth.json
per_point_labels_*.npz

# pipeline run folders (large, regenerated by run_pipeline.py); a curated copy of one
# run is committed in example_results/
outputs/
run_check/
run_check.log
*.npz

# local development history and trial-and-error work
_archive/
